{
  "expo": {
    "name": "HomeChef",
    "slug": "HomeChef",
    "scheme": "homechef",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "HomeChef uses your camera to scan ingredients and add them to your pantry."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HomeChef uses your photos to recognize ingredients and add them to your pantry."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

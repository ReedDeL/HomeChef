# Supabase (accounts) — from your Supabase project settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Photo-based ingredient recognition — URL of the deployed Supabase Edge
# Function in supabase/functions/recognize-ingredients (proxies to Clarifai
# so the Clarifai key never ships in the client). Leave blank to use the
# mocked scan result during development.
# e.g. https://<project-ref>.supabase.co/functions/v1/recognize-ingredients
EXPO_PUBLIC_INGREDIENT_RECOGNITION_URL=

# TheMealDB — only used by scripts/build_catalog.py at build time, never at runtime.
# Test key "1" works for development. Swap for a supporter key before public app store release.
THEMEALDB_API_KEY=1

# Spoonacular — optional fallback, only wired up if TheMealDB's ~300 recipes prove too thin.
# Also build-time only, not read at runtime.
SPOONACULAR_API_KEY=

# ---------------------------------------------------------------------------
# HomeChef environment. Copy to `.env` and fill in. `.env` is gitignored.
#
# ONLY these two variables may be public. Anything prefixed EXPO_PUBLIC_ is
# compiled into the client bundle and is readable by anyone who downloads the
# app. Third-party API keys NEVER go here — they live in Supabase secrets and
# are read only inside Edge Functions. See docs/06_API_KEYS_AND_ENV.md.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijk.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key. Safe to ship: RLS is what protects the data.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# PostHog project token and API host. Both are public client configuration.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com


# ---------------------------------------------------------------------------
# NOT read by the client. Listed here so nobody has to guess the names.
# Set these with: supabase secrets set NAME=value
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=        # analyze-pantry-photo Edge Function
# SPOONACULAR_API_KEY=   # tier-2 search Edge Function (Milestone 4)

# ---------------------------------------------------------------------------
# Build-time only, for tools/catalog. Never read at runtime.
# ---------------------------------------------------------------------------
# THEMEALDB_API_KEY=1    # "1" is the free public test key

{
  "name": "homechef",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:test:build": "bash scripts/android-test.sh build",
    "android:test:emulator": "bash scripts/android-test.sh emulator",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "web:build": "rm -rf dist && expo export --platform web",
    "web:serve": "node scripts/serve-web.mjs",
    "web:beta": "npm run web:build && npm run web:serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.90.2",
    "expo": "^57.0.11",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.10",
    "expo-image-manipulator": "~57.0.8",
    "expo-image-picker": "~57.0.8",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.2",
    "react-native-get-random-values": "~1.11.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.1.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.0"
    }
  }
}
